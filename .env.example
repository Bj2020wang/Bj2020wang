VITE_CLOUDBASE_ENV_ID=cloudbase-xxxx
VITE_CLOUDBASE_REGION=ap-shanghai
VITE_CLOUDBASE_PUBLISHABLE_KEY=
# 可选：与控制台「HTTP 访问服务」默认域名一致（末尾不要路径）。可只写主机名，代码会自动补 https://。
# 不配时使用仓库内置默认预付网关（与 v0.2.x 安装包一致）。切勿写无协议的裸域名却指望浏览器当绝对地址（否则会请求到 localhost）。
# VITE_ACCOUNT_HTTP_BASE=https://your-env-id-xxxxx.ap-shanghai.app.tcloudbase.com
# 可选：HTTP 路由路径须与控制台一致，默认为 /test
# VITE_ACCOUNT_HTTP_PATH=/test
# 用手机或局域网 IP 打开前端时：须在 CloudBase 控制台 → 环境 → 安全配置 → Web 安全域名 中添加与地址栏完全一致的来源（含端口），否则发码会报 Load failed；详见 PROJECT_GUIDE.md §7。
# 同步诊断日志（watch / 轮询等），需要时改为 true 并重启
# VITE_SYNC_DEBUG=true
